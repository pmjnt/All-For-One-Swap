{
  "name": "all-for-one-swap",
  "version": "1.0.0",
  "description": "Safely consolidate reviewed EVM assets from a local CLI",
  "directories": {
    "doc": "docs"
  },
  "bin": {
    "all-for-one": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke:mainnet": "tsx scripts/mainnet-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "decimal.js": "^10.6.0",
    "viem": "^2.56.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
